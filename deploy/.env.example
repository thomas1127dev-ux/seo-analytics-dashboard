APP_ENV=dev

# 前端对外访问地址（用于生成链接等，可根据实际域名修改）
PUBLIC_BASE_URL=http://localhost:5173

# 浏览器访问后端 API 的地址（前端构建时注入，需与 BACKEND_PORT 对应，生产环境改为实际域名）
PUBLIC_BACKEND_URL=http://localhost:4000

# 前端构建时使用的 NPM registry（可选）
# 默认在 docker-compose 中会使用 https://registry.npmmirror.com
# 如果公司有自己的 npm 私有镜像，可在此处改为内网地址，例如：
# NPM_REGISTRY=http://npm.internal.company.com
NPM_REGISTRY=

# 后端服务端口（容器内部默认 4000，外部可按需映射）
BACKEND_PORT=4000

# 前端服务端口（对外暴露端口）
FRONTEND_PORT=5173

# CORS 允许的前端来源（逗号分隔）
FRONTEND_ORIGIN=http://localhost:5173

# MySQL 数据库配置（容器内访问宿主机 MySQL 时，Linux 可用 host.docker.internal 或宿主机实际 IP）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seo_analytics_dashboard

# 认证相关（生产环境必须覆盖默认值）
JWT_SECRET_KEY=please_change_me_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60

# Google Service Account（按需填写）
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Yandex 访问 Token（按需填写）
# YANDEX_ACCESS_TOKEN=


APP_ENV=dev

# 前端对外访问地址（用于生成链接等，可根据实际域名修改）
PUBLIC_BASE_URL=http://localhost:5173

# 浏览器访问后端 API 的地址（前端构建时注入，需与 BACKEND_PORT 对应，生产环境改为实际域名）
PUBLIC_BACKEND_URL=http://localhost:4000

# 前端构建时使用的 NPM registry（可选）
# 默认在 docker-compose 中会使用 https://registry.npmmirror.com
# 如果公司有自己的 npm 私有镜像，可在此处改为内网地址，例如：
# NPM_REGISTRY=http://npm.internal.company.com
NPM_REGISTRY=

# 后端服务端口（容器内部默认 4000，外部可按需映射）
BACKEND_PORT=4000

# 前端服务端口（对外暴露端口）
FRONTEND_PORT=5173

# CORS 允许的前端来源（逗号分隔）
FRONTEND_ORIGIN=http://localhost:5173

# MySQL 数据库配置
# 默认使用 docker-compose 内置的 mysql 服务，并自动创建 seo_analytics_dashboard 数据库。
# 如果你有公司统一的 MySQL 实例，也可以将 DB_HOST 改为该实例地址，并按需调整账号密码。
DB_HOST=mysql
DB_PORT=3306
DB_USER=seoapp
DB_PASSWORD=seoapp_pass
DB_NAME=seo_analytics_dashboard

# MySQL root 密码（仅在使用内置 mysql 容器时用于初始化）
DB_ROOT_PASSWORD=root

# 认证相关（生产环境必须覆盖默认值）
JWT_SECRET_KEY=please_change_me_to_a_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60


# ============================
# 后端局部环境变量示例（可选）
# 通常推荐在仓库根目录使用统一的 .env.example
# 这里给出后端服务本身常用的最小集合。
# ============================

PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# MySQL 数据库配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seo_analytics_dashboard

# Google Service Account
# 推荐将公司提供的 JSON 内容粘贴到此变量中（勿提交真实值）
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# 或者使用本地 JSON 文件路径（仅本地开发）
# GOOGLE_APPLICATION_CREDENTIALS=./bold-syntax-384108-da6937288337.json

